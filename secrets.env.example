# Copy to secrets.env (git-ignored) and fill in. Loaded by `make` for the targets
# that need it, or in your shell with:  source scripts/load_secrets.sh
#
# Hugging Face token (read access is enough): gated datasets in make fetch-hf
# (lmsys/lmsys-chat-1m, Idavidrein/gpqa). https://huggingface.co/settings/tokens
HF_TOKEN=
# GitHub token (optional): higher API rate limit for directory listings in make fetch.
GH_TOKEN=
